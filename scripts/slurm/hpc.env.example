# Settings for a staged Slurm run. Copy to local/hpc.env (untracked), fill in,
# then submit from the checkout root:
#
#     bash scripts/slurm/submit_all.sh local/hpc.env
#
# Plain shell assignments: submit_all.sh sources this file and hands every
# value on to the three jobs.

ACCOUNT=def-xxx
REPO=/project/<id>/path3d               # checkout the jobs run (its src/, not the image's)
SIF=$REPO/path3d.sif
P3HOME=$HOME/path3d-home                # container home: Hugging Face token + model caches

MANIFEST=/path/to/manifest.csv
OUTDIR=$SCRATCH/path3d_runs/<run name>  # must not hold a finished volume
DPT_CKPT=/path/to/dpt_v2.pt

# Cut thickness and staining interval: 4 um sections, every second one stained
SECTION_THICKNESS_UM=4
SAMPLING_INTERVAL=2

# The GPU stage: how many array tasks share the sections, and what each gets.
# Each task takes one MIG slice of an H100, billed at a fraction of a full GPU
# (3g.40gb: 6.1 RGU against 12.2). A job may hold only one slice, so N_TASKS
# is what spreads the work. Slices on Nibi (from sinfo, 2026-11-04):
# nvidia_h100_80gb_hbm3_1g.10gb, nvidia_h100_80gb_hbm3_2g.20gb,
# nvidia_h100_80gb_hbm3_3g.40gb; a full GPU is h100. To list the names a cluster takes:
#     sinfo -o "%G" | grep gpu | sed 's/gpu://g' | sed 's/),/\n/g' | cut -d: -f1 | sort -u
# Cores and memory per task follow from GPU (see submit_all.sh); set
# SECTIONS_CPUS / SECTIONS_MEM to override them.
N_TASKS=10
GPU=nvidia_h100_80gb_hbm3_3g.40gb:1

# Passed to scripts/run_full.py in every stage, e.g. "--no-nuclei".
# "--segment-first" segments the original slides, then warps the labels onto
# the registered canvas (raw label maps land in $OUTDIR/label_maps_raw/).
EXTRA_ARGS=""
