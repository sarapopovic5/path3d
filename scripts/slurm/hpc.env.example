# Settings for a staged Slurm run. Copy to local/hpc.env (untracked), fill in,
# then submit from the checkout root:
#
#     bash scripts/slurm/submit_all.sh local/hpc.env
#
# Plain shell assignments: submit_all.sh sources this file and hands every
# value on to the three jobs.

ACCOUNT=def-xxx
REPO=/project/<id>/path3d               # checkout the jobs run (its src/, not the image's)
SIF=$REPO/path3d.sif
P3HOME=$HOME/path3d-home                # container home: Hugging Face token + model caches

MANIFEST=/path/to/manifest.csv
OUTDIR=$SCRATCH/path3d_runs/<run name>  # must not hold a finished volume
DPT_CKPT=/path/to/dpt_v2.pt

# Cut thickness and staining interval: 4 um sections, every second one stained
SECTION_THICKNESS_UM=4
SAMPLING_INTERVAL=2

# The GPU stage: how many array tasks share the sections, and what each gets.
# A MIG slice of an H100 is billed at a fraction of a full one; `sinfo -o %G`
# lists the GPU names the cluster takes.
N_TASKS=10
GPU=h100:1

# Passed to scripts/run_full.py in every stage, e.g. "--no-nuclei"
EXTRA_ARGS=""
